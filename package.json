{
  "name": "dsh-deepseek-web-littlecar30",
  "description": "DeepSeek Harness 桌面版网页通道插件：通过真实 Edge/Chrome 使用 DeepSeek 免费网页版，支持可选 Kimi/GLM 审核和中文配置页。",
  "version": "0.2.13",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "tools",
    "dsh.patch.yml",
    "cordis.yml",
    "INSTALL.md",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "RELEASING.md"
  ],
  "meta": {
    "title": "DeepSeek 网页版通道",
    "description": "用 chat.deepseek.com 免费网页版驱动 dsh 的主通道，并可选接入 Kimi / GLM 独立审核。"
  },
  "dependencies": {
    "playwright-core": "1.61.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/schemastery": "~3.18.4",
    "react": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "build:host": "tsdown --config tsdown.host.config.ts --config-loader tsx",
    "build:client": "tsdown --config tsdown.config.ts --config-loader tsx",
    "test:parsers": "tsx tools/synthetic-parse-check.ts && tsx tools/kimi-parse-check.ts && tsx tools/kimi-gzip-check.ts && tsx tools/glm-parse-check.ts && tsx tools/action-repair-check.ts && tsx tools/review-evidence-check.ts && tsx tools/rate-limit-check.ts && tsx tools/usage-check.ts && tsx tools/handoff-check.ts && tsx tools/adapter-output-check.ts && tsx tools/compaction-check.ts",
    "pack": "npm pack"
  },
  "devDependencies": {
    "react": "^19.1.1",
    "tsdown": "^0.15.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "author": "LittleCar30",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LittleCar30/dsh-deepseek-web.git"
  },
  "homepage": "https://github.com/LittleCar30/dsh-deepseek-web#readme",
  "bugs": {
    "url": "https://github.com/LittleCar30/dsh-deepseek-web/issues"
  }
}
